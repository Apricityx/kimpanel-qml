+bool WaylandInputWindow::qmlActive() const {
+    return qmlMode_ && qml_ && qml_->available();
+}
+
+void WaylandInputWindow::hidePanel() {
+    ++qmlEpoch_;
+    if (qmlActive()) {
+        qml_->send({{"visible", false}, {"epoch", qmlEpoch_}, {"session", qmlSession_}});
+        qml_->clearFrame();
+    }
+    qmlMode_ = false;
+    hoverIndex_ = -1;
+    window_->hide();
+    repaintIC_.unwatch();
+    panelSurface_.reset();
+    panelSurfaceV2_.reset();
+    blur_.reset();
+    window_->destroyWindow();
+}
+
+void WaylandInputWindow::updateQml(InputContext *ic) {
+    auto *instance = parent_->instance();
+    auto &panel = ic->inputPanel();
+    const auto preedit = instance->outputFilter(ic, panel.preedit());
+    const auto aux = instance->outputFilter(ic, panel.auxUp()).toString();
+    auto text = aux + preedit.toString();
+    const auto down = instance->outputFilter(ic, panel.auxDown()).toString();
+    if (!down.empty()) text += (text.empty() ? "" : "  ") + down;
+    // fcitx cursors are UTF-8 byte offsets; QML strings use UTF-16 offsets.
+    int caret = -1;
+    if (preedit.cursor() >= 0 && size_t(preedit.cursor()) <= preedit.toString().size()) {
+        const auto prefix = aux + preedit.toString().substr(0, preedit.cursor());
+        caret = 0;
+        for (auto ch : prefix) {
+            auto byte = static_cast<unsigned char>(ch);
+            if ((byte & 0xc0) != 0x80) caret += byte >= 0xf0 ? 2 : 1;
+        }
+    }
+    nlohmann::json candidates = nlohmann::json::array();
+    int pageDir = 0;
+    if (auto list = panel.candidateList()) {
+        for (int i = 0; i < list->size(); ++i) {
+            const auto &candidate = list->candidate(i);
+            if (candidate.isPlaceHolder()) continue;
+            const auto label = candidate.hasCustomLabel() ? candidate.customLabel() : list->label(i);
+            candidates.push_back({{"label", instance->outputFilter(ic, label).toString()},
+                                  {"text", instance->outputFilter(ic, candidate.textWithComment()).toString()}});
+        }
+        if (auto *pageable = list->toPageable()) {
+            const int page = pageable->currentPage();
+            if (page >= 0 && qmlPage_ >= 0 && page != qmlPage_) pageDir = page > qmlPage_ ? 1 : -1;
+            qmlPage_ = page;
+        }
+    }
+    ++qmlEpoch_;
+    qmlScale_ = window_->bufferScale();
+    qml_->send({{"visible", true}, {"epoch", qmlEpoch_}, {"session", qmlSession_},
+                {"scale", qmlScale_ / WaylandWindow::ScaleDominatorF},
+                {"text", text}, {"caret", caret}, {"candidates", candidates},
+                {"cursor", candidateIndex_}, {"hasPrev", hasPrev_}, {"hasNext", hasNext_},
+                {"vertical", layoutHint_ == CandidateLayoutHint::Vertical}, {"pageDir", pageDir}});
+}
+
+void WaylandInputWindow::renderQml() {
+    if (!qmlActive() || !window_->surface() || !panelSurfaceV2_) return;
+    auto *ic = repaintIC_.get();
+    if (!ic || !ic->hasFocus()) { hidePanel(); return; }
+    const auto &frame = qml_->frame();
+    if (frame.epoch != qmlEpoch_ || frame.pixels.empty()) return;
+    window_->resize(frame.logicalWidth, frame.logicalHeight);
+    if (auto *surface = window_->prerender()) {
+        auto *source = cairo_image_surface_create_for_data(
+            const_cast<unsigned char *>(frame.pixels.data()), CAIRO_FORMAT_ARGB32,
+            frame.width, frame.height, frame.stride);
+        auto *cr = cairo_create(surface);
+        cairo_set_operator(cr, CAIRO_OPERATOR_SOURCE);
+        cairo_scale(cr, double(cairo_image_surface_get_width(surface)) / frame.width,
+                    double(cairo_image_surface_get_height(surface)) / frame.height);
+        cairo_set_source_surface(cr, source, 0, 0);
+        cairo_paint(cr);
+        cairo_destroy(cr);
+        cairo_surface_destroy(source);
+        window_->render();
+    }
+}
+
+void WaylandInputWindow::qmlPointer(const char *kind, int x, int y) {
+    if (visible()) qml_->send({{"pointer", kind}, {"x", x}, {"y", y}, {"epoch", qmlEpoch_}});
+}
+
+void WaylandInputWindow::qmlMessage(const nlohmann::json &message) {
+    if (message.contains("failed")) {
+        CLASSICUI_ERROR() << "QML popup renderer disconnected; using classicui drawing";
+        if (qmlMode_) {
+            qmlMode_ = false;
+            if (auto *ic = repaintIC_.get(); ic && ic->hasFocus()) update(ic);
+            else hidePanel();
+        }
+        return;
+    }
+    if (!qmlActive() || message.value("epoch", uint64_t(0)) != qmlEpoch_) return;
+    if (message.contains("hidden")) {
+        if (!visible()) hidePanel();
+    } else if (message.contains("frame")) {
+        renderQml();
+    } else if (message.contains("command") && visible()) {
+        auto *ic = repaintIC_.get();
+        if (!ic || !ic->hasFocus()) return;
+        const auto list = ic->inputPanel().candidateList();
+        if (!list) return;
+        const std::string command = message.at("command");
+        if (command == "prev" || command == "next") {
+            if (auto *pageable = list->toPageable()) {
+                if (command == "prev" && pageable->hasPrev()) pageable->prev();
+                else if (command == "next" && pageable->hasNext()) pageable->next();
+                else return;
+                ic->updateUserInterface(UserInterfaceComponent::InputPanel);
+            }
+        } else if (command.compare(0, 7, "select ") == 0) {
+            char *end;
+            const auto index = strtol(command.c_str() + 7, &end, 10);
+            if (*end || index < 0) return;
+            int local = 0;
+            for (int i = 0; i < list->size(); ++i) {
+                const auto &candidate = list->candidate(i);
+                if (candidate.isPlaceHolder()) continue;
+                if (local++ == index) { candidate.select(ic); return; }
+            }
+        }
+    }
+}
+
 } // namespace fcitx::classicui
